# Copiar para secrets/production.deploy.local.env (ignorado pelo Git).
# Pode reutilizar o mesmo ficheiro do repo WELLS_API.

WARDEN_DEPLOY_SSH_HOST=ssh.example.com
WARDEN_DEPLOY_SSH_USER=deploy
WARDEN_DEPLOY_SSH_PORT=22

# Path do runtime Warden no servidor (obrigatório para scripts SSH/sync/cleanup)
WARDEN_RUNTIME_ROOT=/opt/warden

# WARDEN_HUB_ROOT=/usr/share/nginx/html/platform-hub

# Opcional: reservado para tarefas remotas que precisem de sudo (nunca commitar valor real)
# WARDEN_SUDO_PASSWORD=
