# ============================================
# Warden - Environment Configuration
# ============================================
# Copy to .env and fill with real values

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=warden
DB_PASSWORD=change_me
DB_NAME=Warden

# SSH Tunnel (optional, for remote DB)
# SSH_HOST=
# SSH_PORT=22
# SSH_USER=
# SSH_KEY_PATH=

# Collector
COLLECT_INTERVAL=15
RETENTION_DAYS=30

# Disk top consumers (scan pesado -> usa cache)
DISK_TOP_ENABLED=true
DISK_TOP_ROOT=/
DISK_TOP_MAX_ITEMS=10
DISK_TOP_SCAN_INTERVAL_SECONDS=300
DISK_TOP_TIMEOUT_SECONDS=10
DISK_TOP_EXCLUDE_PREFIXES=/proc,/sys,/dev,/run,/snap,/tmp,/var/tmp
DISK_TOP_SCAN_MODE=local
DISK_TOP_SUDO_HELPER_CMD=/usr/local/sbin/warden-disk-top-helper
DISK_TOP_SUDO_TIMEOUT_SECONDS=12

# Frontend export
EXPORT_PATH=frontend/warden_payload.json

# MariaDB monitor
DB_MONITOR_ENABLED=true
DB_MONITOR_INTERVAL=60

# Slack
SLACK_ENABLED=true
SLACK_CONFIG_PATH=secrets/slack.json
SLACK_ALERT_COOLDOWN_MINUTES=15
SLACK_DIGEST_HOUR_UTC=8
SLACK_DIGEST_MINUTE_UTC=0

# Conservative alert thresholds
ALERT_CPU_WARN=85
ALERT_RAM_WARN=90
ALERT_DISK_WARN=92
ALERT_DB_THREADS_RUNNING_WARN=20
ALERT_DB_SLOW_QPS_WARN=1

# Logging
LOG_LEVEL=INFO
LOG_FILE=runtime/logs/warden.log
