# Warden runtime
LOG_LEVEL=INFO
LOG_FILE=runtime/logs/warden.log
COLLECT_INTERVAL=15
RETENTION_DAYS=7

# Optional DB maintenance used by Warden Clean.
# Keep binlog purge disabled unless backup/PITR policy allows the chosen window.
WARDEN_CLEAN_BINLOG_RETENTION_DAYS=0
WARDEN_CLEAN_OPTIMIZE_ENABLED=0
WARDEN_CLEAN_OPTIMIZE_MIN_FREE_MB=512
WARDEN_CLEAN_OPTIMIZE_TABLES=warden_metrics,warden_alert_events,warden_ingest_registry

# MariaDB/MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=warden
DB_PASSWORD=change-me
DB_NAME=Warden

# Optional SSH tunnel
SSH_HOST=
SSH_PORT=22
SSH_USER=
SSH_KEY_PATH=

# Monitoring
MONITOR_ROOT_PATH=/
DISK_TOP_ENABLED=1
DISK_TOP_ROOT=/
DISK_TOP_MAX_ITEMS=10
DISK_TOP_SCAN_INTERVAL_SECONDS=300
DISK_TOP_TIMEOUT_SECONDS=10
DISK_TOP_EXCLUDE_PREFIXES=/proc,/sys,/dev,/run,/snap,/tmp,/var/tmp
DISK_TOP_SCAN_MODE=local
DISK_TOP_SUDO_HELPER_CMD=/usr/local/sbin/warden-disk-top-helper
DISK_TOP_SUDO_TIMEOUT_SECONDS=12
PROCESS_TOP_SCAN_INTERVAL_SECONDS=15
PROCESS_TOP_NETWORK_SCAN_INTERVAL_SECONDS=15
DB_MONITOR_ENABLED=1
DB_MONITOR_INTERVAL=60

# Export snapshots (consumidos pela API/UI Warden no host ou frontend externo)
EXPORT_PATH=runtime/export/warden_payload.json
EXPORT_FAST_PATH=runtime/export/warden_fast_snapshot.json
EXPORT_HEAVY_PATH=runtime/export/warden_heavy_snapshot.json

# Optional: export fast inline no collector (desligado por defeito; usar cron 2s)
EXPORT_FAST_ON_COLLECT=0

# Pipeline (Task Manager cadence) — ver docs/Warden_Pipeline.md
# Collector: python -m src.warden (ou warden.py legacy para systemd antigo)
# Cron fast: 30×/min (~2s)     export cache-only (<1s)
# Ops Center poll: ~1.2s       frontend/ops-center.js (HUB)
# EXPORT_FAST_ON_COLLECT=0     opcional; cron é a lane primária

# Weekly archive retention (scripts/weekly_archive.py)
WEEKLY_ARCHIVE_RETENTION_WEEKS=6

# Slack
SLACK_ENABLED=1
SLACK_CONFIG_PATH=secrets/slack.json
WARDEN_SLACK_IMMEDIATE=0
SLACK_ALERT_SUSTAIN_MINUTES=2
SLACK_ALERT_COOLDOWN_MINUTES=15
SLACK_WARNING_SUSTAIN_MINUTES=10
SLACK_WARNING_COOLDOWN_MINUTES=60
SLACK_CRITICAL_SUSTAIN_MINUTES=2
SLACK_CRITICAL_COOLDOWN_MINUTES=15
SLACK_ALERT_MAX_NOTIFICATIONS=5
SLACK_DIGEST_HOUR_UTC=8
SLACK_DIGEST_MINUTE_UTC=30

# Alert thresholds
ALERT_CPU_WARN=85
ALERT_RAM_WARN=90
ALERT_DISK_WARN=95
ALERT_DISK_CRITICAL=98
ALERT_DB_THREADS_RUNNING_WARN=20
ALERT_DB_STORAGE_GB_WARN=20

# Operational jobs (backup DB, inventário SO, backup nginx)
WARDEN_CRONTAB_LOG_DIR=/home/eferreira/D4MAIA/_crontab_logs
WARDEN_OPERATIONAL_OUTPUT_DIR=runtime/operational
WARDEN_BACKUP_DB_DIR=/BackupDB
WARDEN_BACKUP_DB_RETENTION_DAYS=3
WARDEN_BACKUP_DB_SCHEMAS=BAZE,Chronos,Warden,Overseer,MAIATRON
WARDEN_MARIADB_EXTRA_FILE=/home/eferreira/D4MAIA/BaZe_Management/config/baze2_db.conf
WARDEN_NGINX_SOURCE_DIR=/usr/share/nginx/html
WARDEN_NGINX_EXCLUDE_DIR=/usr/share/nginx/html/D4CMMaia/gdrive
WARDEN_NGINX_BACKUP_DIR=/BackupNGINX
WARDEN_NGINX_TEMP_DIR=/tmp/nginx_backup_temp
WARDEN_NGINX_BACKUP_KEEP=3
