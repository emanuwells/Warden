# ============================================
# Warden — Cron Schedule (Ubuntu)
# ============================================
# Add to crontab: crontab -e
# Path canónico em produção MAIATRON (ajustar se necessário):
WARDEN_ROOT=/home/eferreira/MAIATRON/Warden
# Legado: algumas instalações antigas usavam /opt/warden (symlink ou cópia).

# FAST snapshot (light lane, near-real-time)
* * * * * sleep 0;  flock -n /tmp/warden_export_fast.lock -c 'cd $WARDEN_ROOT && /usr/bin/python3 scripts/export_payload.py --mode fast > /dev/null 2>> runtime/logs/export_fast.err.log'
* * * * * sleep 2;  flock -n /tmp/warden_export_fast.lock -c 'cd $WARDEN_ROOT && /usr/bin/python3 scripts/export_payload.py --mode fast > /dev/null 2>> runtime/logs/export_fast.err.log'
