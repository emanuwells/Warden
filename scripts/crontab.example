* * * * * sleep 58; flock -n /tmp/warden_export_fast.lock -c 'cd $WARDEN_ROOT && /usr/bin/python3 scripts/export_payload.py --mode fast > /dev/null 2>> runtime/logs/export_fast.err.log'

# HEAVY snapshot (history, processes, disk top consumers)
*/5 * * * * flock -n /tmp/warden_export_heavy.lock -c 'cd $WARDEN_ROOT && /usr/bin/python3 scripts/export_payload.py --mode heavy > /dev/null 2>> runtime/logs/export_heavy.err.log'

# Slack alerts (threshold warnings/criticals) every 2 minutes
*/2 * * * * cd $WARDEN_ROOT && /usr/bin/python3 scripts/slack_alerts.py > /dev/null 2>> runtime/logs/slack_alerts.err.log

# Daily Slack digest at 08:00 (server local time)
0 8 * * * cd $WARDEN_ROOT && /usr/bin/python3 scripts/slack_daily_digest.py >> runtime/logs/slack_daily_digest.log 2>&1

# Daily janitor at 03:00
0 3 * * * flock -n /tmp/warden_janitor.lock -c 'cd $WARDEN_ROOT && /usr/bin/python3 scripts/janitor.py >> runtime/logs/janitor.log 2>&1'

# Weekly hourly archive (Sunday 23:58 UTC/local host time)
58 23 * * 0 flock -n /tmp/warden_weekly_archive.lock -c 'cd $WARDEN_ROOT && /usr/bin/python3 scripts/weekly_archive.py >> runtime/logs/weekly_archive.log 2>&1'

# Daily trim for large runtime logs
25 3 * * * find $WARDEN_ROOT/runtime/logs -maxdepth 1 -type f \( -name '*.log' -o -name '*.err.log' \) -size +20M -exec truncate -s 0 {} +

# Optional root cron outside the runtime user:
# 20 3 * * 0 /usr/local/sbin/maiatron_weekly_housekeeping.sh
# Source of truth for that script lives in this repo:
# $WARDEN_ROOT/scripts/maiatron_weekly_housekeeping.sh
