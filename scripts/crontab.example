# ============================================
# Warden — Cron Schedule (Ubuntu)
# ============================================
# Add to crontab: crontab -e
# Ajustar WARDEN_ROOT ao path de instalação do runtime no host:
WARDEN_ROOT=/opt/warden
# Legado: algumas instalações antigas usavam /opt/warden (symlink ou cópia).
#
# Alinhamento pipeline — ver docs/architecture/warden-pipeline.md
# | Lane   | Schedule        | Snapshot                         | Stale API (ms) |
# |--------|-----------------|----------------------------------|----------------|
# | fast   | 30×/min (~2s)   | runtime/export/warden_fast_*     | 12000          |
# | heavy  | */5             | runtime/export/warden_heavy_*    | 600000         |
# | full   | */15            | runtime/export/warden_payload.*  | 600000         |
# Collector (systemd): COLLECT_INTERVAL=2 — só persiste na DB.
# Export fast: lane dedicada 2s (cache-only, <1s). Ops Center poll ~1.2s.

# FAST snapshot (2s cadence — Task Manager lane) # warden:export_fast_2s
* * * * * sleep 0;  flock -n /tmp/warden_export_fast.lock -c 'cd $WARDEN_ROOT && /usr/bin/python3 scripts/export_payload.py --mode fast > /dev/null 2>> runtime/logs/export_fast.err.log' # warden:export_fast_2s
* * * * * sleep 2;  flock -n /tmp/warden_export_fast.lock -c 'cd $WARDEN_ROOT && /usr/bin/python3 scripts/export_payload.py --mode fast > /dev/null 2>> runtime/logs/export_fast.err.log' # warden:export_fast_2s
* * * * * sleep 4;  flock -n /tmp/warden_export_fast.lock -c 'cd $WARDEN_ROOT && /usr/bin/python3 scripts/export_payload.py --mode fast > /dev/null 2>> runtime/logs/export_fast.err.log' # warden:export_fast_2s
* * * * * sleep 6;  flock -n /tmp/warden_export_fast.lock -c 'cd $WARDEN_ROOT && /usr/bin/python3 scripts/export_payload.py --mode fast > /dev/null 2>> runtime/logs/export_fast.err.log' # warden:export_fast_2s
* * * * * sleep 8;  flock -n /tmp/warden_export_fast.lock -c 'cd $WARDEN_ROOT && /usr/bin/python3 scripts/export_payload.py --mode fast > /dev/null 2>> runtime/logs/export_fast.err.log' # warden:export_fast_2s
* * * * * sleep 10; flock -n /tmp/warden_export_fast.lock -c 'cd $WARDEN_ROOT && /usr/bin/python3 scripts/export_payload.py --mode fast > /dev/null 2>> runtime/logs/export_fast.err.log' # warden:export_fast_2s
* * * * * sleep 12; flock -n /tmp/warden_export_fast.lock -c 'cd $WARDEN_ROOT && /usr/bin/python3 scripts/export_payload.py --mode fast > /dev/null 2>> runtime/logs/export_fast.err.log' # warden:export_fast_2s
* * * * * sleep 14; flock -n /tmp/warden_export_fast.lock -c 'cd $WARDEN_ROOT && /usr/bin/python3 scripts/export_payload.py --mode fast > /dev/null 2>> runtime/logs/export_fast.err.log' # warden:export_fast_2s
* * * * * sleep 16; flock -n /tmp/warden_export_fast.lock -c 'cd $WARDEN_ROOT && /usr/bin/python3 scripts/export_payload.py --mode fast > /dev/null 2>> runtime/logs/export_fast.err.log' # warden:export_fast_2s
* * * * * sleep 18; flock -n /tmp/warden_export_fast.lock -c 'cd $WARDEN_ROOT && /usr/bin/python3 scripts/export_payload.py --mode fast > /dev/null 2>> runtime/logs/export_fast.err.log' # warden:export_fast_2s
* * * * * sleep 20; flock -n /tmp/warden_export_fast.lock -c 'cd $WARDEN_ROOT && /usr/bin/python3 scripts/export_payload.py --mode fast > /dev/null 2>> runtime/logs/export_fast.err.log' # warden:export_fast_2s
* * * * * sleep 22; flock -n /tmp/warden_export_fast.lock -c 'cd $WARDEN_ROOT && /usr/bin/python3 scripts/export_payload.py --mode fast > /dev/null 2>> runtime/logs/export_fast.err.log' # warden:export_fast_2s
* * * * * sleep 24; flock -n /tmp/warden_export_fast.lock -c 'cd $WARDEN_ROOT && /usr/bin/python3 scripts/export_payload.py --mode fast > /dev/null 2>> runtime/logs/export_fast.err.log' # warden:export_fast_2s
* * * * * sleep 26; flock -n /tmp/warden_export_fast.lock -c 'cd $WARDEN_ROOT && /usr/bin/python3 scripts/export_payload.py --mode fast > /dev/null 2>> runtime/logs/export_fast.err.log' # warden:export_fast_2s
* * * * * sleep 28; flock -n /tmp/warden_export_fast.lock -c 'cd $WARDEN_ROOT && /usr/bin/python3 scripts/export_payload.py --mode fast > /dev/null 2>> runtime/logs/export_fast.err.log' # warden:export_fast_2s
* * * * * sleep 30; flock -n /tmp/warden_export_fast.lock -c 'cd $WARDEN_ROOT && /usr/bin/python3 scripts/export_payload.py --mode fast > /dev/null 2>> runtime/logs/export_fast.err.log' # warden:export_fast_2s
* * * * * sleep 32; flock -n /tmp/warden_export_fast.lock -c 'cd $WARDEN_ROOT && /usr/bin/python3 scripts/export_payload.py --mode fast > /dev/null 2>> runtime/logs/export_fast.err.log' # warden:export_fast_2s
* * * * * sleep 34; flock -n /tmp/warden_export_fast.lock -c 'cd $WARDEN_ROOT && /usr/bin/python3 scripts/export_payload.py --mode fast > /dev/null 2>> runtime/logs/export_fast.err.log' # warden:export_fast_2s
* * * * * sleep 36; flock -n /tmp/warden_export_fast.lock -c 'cd $WARDEN_ROOT && /usr/bin/python3 scripts/export_payload.py --mode fast > /dev/null 2>> runtime/logs/export_fast.err.log' # warden:export_fast_2s
* * * * * sleep 38; flock -n /tmp/warden_export_fast.lock -c 'cd $WARDEN_ROOT && /usr/bin/python3 scripts/export_payload.py --mode fast > /dev/null 2>> runtime/logs/export_fast.err.log' # warden:export_fast_2s
* * * * * sleep 40; flock -n /tmp/warden_export_fast.lock -c 'cd $WARDEN_ROOT && /usr/bin/python3 scripts/export_payload.py --mode fast > /dev/null 2>> runtime/logs/export_fast.err.log' # warden:export_fast_2s
* * * * * sleep 42; flock -n /tmp/warden_export_fast.lock -c 'cd $WARDEN_ROOT && /usr/bin/python3 scripts/export_payload.py --mode fast > /dev/null 2>> runtime/logs/export_fast.err.log' # warden:export_fast_2s
* * * * * sleep 44; flock -n /tmp/warden_export_fast.lock -c 'cd $WARDEN_ROOT && /usr/bin/python3 scripts/export_payload.py --mode fast > /dev/null 2>> runtime/logs/export_fast.err.log' # warden:export_fast_2s
* * * * * sleep 46; flock -n /tmp/warden_export_fast.lock -c 'cd $WARDEN_ROOT && /usr/bin/python3 scripts/export_payload.py --mode fast > /dev/null 2>> runtime/logs/export_fast.err.log' # warden:export_fast_2s
* * * * * sleep 48; flock -n /tmp/warden_export_fast.lock -c 'cd $WARDEN_ROOT && /usr/bin/python3 scripts/export_payload.py --mode fast > /dev/null 2>> runtime/logs/export_fast.err.log' # warden:export_fast_2s
* * * * * sleep 50; flock -n /tmp/warden_export_fast.lock -c 'cd $WARDEN_ROOT && /usr/bin/python3 scripts/export_payload.py --mode fast > /dev/null 2>> runtime/logs/export_fast.err.log' # warden:export_fast_2s
* * * * * sleep 52; flock -n /tmp/warden_export_fast.lock -c 'cd $WARDEN_ROOT && /usr/bin/python3 scripts/export_payload.py --mode fast > /dev/null 2>> runtime/logs/export_fast.err.log' # warden:export_fast_2s
* * * * * sleep 54; flock -n /tmp/warden_export_fast.lock -c 'cd $WARDEN_ROOT && /usr/bin/python3 scripts/export_payload.py --mode fast > /dev/null 2>> runtime/logs/export_fast.err.log' # warden:export_fast_2s
* * * * * sleep 56; flock -n /tmp/warden_export_fast.lock -c 'cd $WARDEN_ROOT && /usr/bin/python3 scripts/export_payload.py --mode fast > /dev/null 2>> runtime/logs/export_fast.err.log' # warden:export_fast_2s
* * * * * sleep 58; flock -n /tmp/warden_export_fast.lock -c 'cd $WARDEN_ROOT && /usr/bin/python3 scripts/export_payload.py --mode fast > /dev/null 2>> runtime/logs/export_fast.err.log' # warden:export_fast_2s

# HEAVY snapshot (history, processes, disk top consumers)
*/5 * * * * flock -n /tmp/warden_export_heavy.lock -c 'cd $WARDEN_ROOT && /usr/bin/python3 scripts/export_payload.py --mode heavy > /dev/null 2>> runtime/logs/export_heavy.err.log'

# FULL snapshot (merged payload for Ops Center fallback and legacy consumers)
*/15 * * * * flock -n /tmp/warden_export_full.lock -c 'cd $WARDEN_ROOT && /usr/bin/python3 scripts/export_payload.py --mode full > /dev/null 2>> runtime/logs/export_full.err.log'

# Slack alerts (threshold warnings/criticals) every 2 minutes
*/2 * * * * cd $WARDEN_ROOT && WARDEN_SLACK_IMMEDIATE=1 /usr/bin/python3 scripts/slack_alerts.py > /dev/null 2>> runtime/logs/slack_alerts.err.log

# Daily Slack digest at 08:30 (server local time)
30 8 * * * cd $WARDEN_ROOT && /usr/bin/python3 scripts/slack_daily_digest.py >> runtime/logs/slack_daily_digest.log 2>&1

# Daily Warden Clean retention at 03:00
0 3 * * * flock -n /tmp/warden_clean_retention.lock -c 'cd $WARDEN_ROOT && /usr/bin/python3 scripts/warden_clean.py >> runtime/logs/warden_clean.log 2>&1'

# Weekly hourly archive (Sunday 23:58 UTC/local host time)
58 23 * * 0 flock -n /tmp/warden_weekly_archive.lock -c 'cd $WARDEN_ROOT && /usr/bin/python3 scripts/weekly_archive.py >> runtime/logs/weekly_archive.log 2>&1'

# Daily trim for large runtime logs
25 3 * * * find $WARDEN_ROOT/runtime/logs -maxdepth 1 -type f \( -name '*.log' -o -name '*.err.log' \) -size +20M -exec truncate -s 0 {} +

# Overseer-visible Warden cleanup runner. Production crontab must contain this marker once.
0 1 * * * ${OVERSEER_RUNNERS_ROOT:-/opt/overseer-runners}/warden_clean/run.sh >> ${WARDEN_CRONTAB_LOG_DIR:-/var/log/overseer}/crontab_warden_clean.txt 2>&1 # overseer:warden_clean

# Overseer-visible operational jobs (Warden scripts)
0 2 * * * ${OVERSEER_RUNNERS_ROOT:-/opt/overseer-runners}/warden_db_backup/run.sh >> ${WARDEN_CRONTAB_LOG_DIR:-/var/log/overseer}/crontab_warden_db_backup.txt 2>&1 # overseer:warden_db_backup
0 2 * * 1 ${OVERSEER_RUNNERS_ROOT:-/opt/overseer-runners}/warden_system_info/run.sh >> ${WARDEN_CRONTAB_LOG_DIR:-/var/log/overseer}/crontab_warden_system_info.txt 2>&1 # overseer:warden_system_info
0 3 * * * ${OVERSEER_RUNNERS_ROOT:-/opt/overseer-runners}/warden_webserver_backup/run.sh >> ${WARDEN_CRONTAB_LOG_DIR:-/var/log/overseer}/crontab_warden_nginx.txt 2>&1 # overseer:warden_webserver_backup

# Host hygiene: logs SO, apt cache, artefactos .bak de deploy (após warden_clean).
# Requer symlink /usr/local/sbin/warden-host-hygiene e scripts/host-hygiene.sudoers.
30 1 * * * flock -n /tmp/host_hygiene.lock -c 'export WARDEN_HUB_ROOT=${WARDEN_HUB_ROOT:-/usr/share/nginx/html/hub} WARDEN_CRONTAB_LOG_DIR=${WARDEN_CRONTAB_LOG_DIR:-/var/log/overseer} && /usr/local/sbin/warden-host-hygiene >> ${WARDEN_CRONTAB_LOG_DIR}/crontab_host_hygiene.txt 2>&1' # overseer:host_hygiene
