* * * * * sleep 58; flock -n /tmp/warden_export_fast.lock -c 'cd /app && python scripts/export_payload.py --mode fast > /dev/null 2>> runtime/logs/export_fast.err.log'

# HEAVY snapshot (every 5 minutes)
*/5 * * * * flock -n /tmp/warden_export_heavy.lock -c 'cd /app && python scripts/export_payload.py --mode heavy > /dev/null 2>> runtime/logs/export_heavy.err.log'

# Slack alerts + digest
*/2 * * * * flock -n /tmp/warden_slack_alerts.lock -c 'cd /app && WARDEN_SLACK_IMMEDIATE=1 python scripts/slack_alerts.py > /dev/null 2>> runtime/logs/slack_alerts.err.log'
30 8 * * * cd /app && python scripts/slack_daily_digest.py >> runtime/logs/slack_daily_digest.log 2>&1

# Retention + weekly archive
0 3 * * * flock -n /tmp/warden_janitor.lock -c 'cd /app && python scripts/janitor.py >> runtime/logs/janitor.log 2>&1'
58 23 * * 0 flock -n /tmp/warden_weekly_archive.lock -c 'cd /app && python scripts/weekly_archive.py >> runtime/logs/weekly_archive.log 2>&1'

# Trim large logs
25 3 * * * find /app/runtime/logs -maxdepth 1 -type f \( -name '*.log' -o -name '*.err.log' \) -size +20M -exec truncate -s 0 {} +
