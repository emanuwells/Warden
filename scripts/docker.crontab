SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
BASH_ENV=/app/runtime/.cron_env

# FAST snapshot fallback (Phase 2 — primary: collector EXPORT_FAST_ON_COLLECT)
* * * * * flock -n /tmp/warden_export_fast.lock -c 'cd /app && bash scripts/export_fast_fallback.sh > /dev/null 2>> runtime/logs/export_fast.err.log' # warden:export_fast_fallback

# HEAVY snapshot (every 5 minutes)
*/5 * * * * flock -n /tmp/warden_export_heavy.lock -c 'cd /app && python scripts/export_payload.py --mode heavy > /dev/null 2>> runtime/logs/export_heavy.err.log'

# FULL snapshot (merged payload for Ops Center fallback)
*/15 * * * * flock -n /tmp/warden_export_full.lock -c 'cd /app && python scripts/export_payload.py --mode full > /dev/null 2>> runtime/logs/export_full.err.log'

# Slack alerts + digest
*/2 * * * * flock -n /tmp/warden_slack_alerts.lock -c 'cd /app && WARDEN_SLACK_IMMEDIATE=1 python scripts/slack_alerts.py > /dev/null 2>> runtime/logs/slack_alerts.err.log'
30 8 * * * cd /app && python scripts/slack_daily_digest.py >> runtime/logs/slack_daily_digest.log 2>&1

# Warden Clean retention + weekly archive
0 3 * * * flock -n /tmp/warden_clean_retention.lock -c 'cd /app && python scripts/warden_clean.py >> runtime/logs/warden_clean.log 2>&1'
58 23 * * 0 flock -n /tmp/warden_weekly_archive.lock -c 'cd /app && python scripts/weekly_archive.py >> runtime/logs/weekly_archive.log 2>&1'

# Trim large logs
25 3 * * * find /app/runtime/logs -maxdepth 1 -type f \( -name '*.log' -o -name '*.err.log' \) -size +20M -exec truncate -s 0 {} +
