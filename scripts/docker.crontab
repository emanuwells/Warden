* * * * * sleep 18; flock -n /tmp/warden_export_fast.lock -c 'cd /app && python scripts/export_payload.py --mode fast > /dev/null 2>> runtime/logs/export_fast.err.log'
* * * * * sleep 20; flock -n /tmp/warden_export_fast.lock -c 'cd /app && python scripts/export_payload.py --mode fast > /dev/null 2>> runtime/logs/export_fast.err.log'
* * * * * sleep 22; flock -n /tmp/warden_export_fast.lock -c 'cd /app && python scripts/export_payload.py --mode fast > /dev/null 2>> runtime/logs/export_fast.err.log'
* * * * * sleep 24; flock -n /tmp/warden_export_fast.lock -c 'cd /app && python scripts/export_payload.py --mode fast > /dev/null 2>> runtime/logs/export_fast.err.log'
* * * * * sleep 26; flock -n /tmp/warden_export_fast.lock -c 'cd /app && python scripts/export_payload.py --mode fast > /dev/null 2>> runtime/logs/export_fast.err.log'
* * * * * sleep 28; flock -n /tmp/warden_export_fast.lock -c 'cd /app && python scripts/export_payload.py --mode fast > /dev/null 2>> runtime/logs/export_fast.err.log'
* * * * * sleep 30; flock -n /tmp/warden_export_fast.lock -c 'cd /app && python scripts/export_payload.py --mode fast > /dev/null 2>> runtime/logs/export_fast.err.log'
* * * * * sleep 32; flock -n /tmp/warden_export_fast.lock -c 'cd /app && python scripts/export_payload.py --mode fast > /dev/null 2>> runtime/logs/export_fast.err.log'
* * * * * sleep 34; flock -n /tmp/warden_export_fast.lock -c 'cd /app && python scripts/export_payload.py --mode fast > /dev/null 2>> runtime/logs/export_fast.err.log'
