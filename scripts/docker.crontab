SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
BASH_ENV=/app/runtime/.cron_env

# FAST snapshot (2s cadence)
* * * * * sleep 0;  flock -n /tmp/warden_export_fast.lock -c 'cd /app && python scripts/export_payload.py --mode fast > /dev/null 2>> runtime/logs/export_fast.err.log'
* * * * * sleep 2;  flock -n /tmp/warden_export_fast.lock -c 'cd /app && python scripts/export_payload.py --mode fast > /dev/null 2>> runtime/logs/export_fast.err.log'
* * * * * sleep 4;  flock -n /tmp/warden_export_fast.lock -c 'cd /app && python scripts/export_payload.py --mode fast > /dev/null 2>> runtime/logs/export_fast.err.log'
