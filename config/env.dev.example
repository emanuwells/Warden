# Variáveis opcionais para docker-compose (copiar para .env ou .env.dev).
# Versão canónica: ficheiro VERSION na raiz do repo.
# Os paths de snapshot são definidos no compose; gerar ficheiros com:
#   .venv/bin/python -m src.warden --once
#   .venv/bin/python scripts/export_payload.py --mode fast
#   .venv/bin/python scripts/export_payload.py --mode heavy
#   .venv/bin/python scripts/export_payload.py --mode full

WARDEN_DEV_PORT=8080
WARDEN_VERSION=2.1.0
