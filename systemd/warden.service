[Unit]
Description=Warden System Resource Monitor
Documentation=https://github.com/your-org/warden
After=network.target mariadb.service

[Service]
Type=simple
User=warden
Group=warden
WorkingDirectory=/home/eferreira/MAIATRON/Warden
ExecStart=/usr/bin/python3 -m src.warden
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=warden

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/home/eferreira/MAIATRON/Warden/runtime

# Environment
EnvironmentFile=/home/eferreira/MAIATRON/Warden/.env

[Install]
WantedBy=multi-user.target
