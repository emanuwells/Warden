[Unit]
Description=Warden System Resource Monitor
Documentation=https://github.com/your-org/warden
After=network.target mariadb.service

[Service]
Type=simple
User=warden
Group=warden
WorkingDirectory=/opt/warden
ExecStart=/usr/bin/python3 /opt/warden/warden.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=warden

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/warden/runtime

# Environment
EnvironmentFile=/opt/warden/.env

[Install]
WantedBy=multi-user.target
